DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/revenue_recovery

# UUID of the (only) business this deploy serves. Defaults in code to the
# id `python -m seed.bootstrap --seed 42` always produces; override if you
# reseeded with a different --seed.
# DEMO_BUSINESS_ID=6765c159-0551-59dd-bb83-bf5277a98f45

# Set from the Razorpay dashboard's webhook config once you have a test
# account (Day 6). POST /v1/webhooks/razorpay returns 404 until this is set.
# RAZORPAY_WEBHOOK_SECRET=whsec_...
