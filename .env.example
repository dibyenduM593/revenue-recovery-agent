DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/revenue_recovery

# UUID of the (only) business this deploy serves. Defaults in code to the
# id `python -m seed.bootstrap --seed 42` always produces; override if you
# reseeded with a different --seed.
# DEMO_BUSINESS_ID=6765c159-0551-59dd-bb83-bf5277a98f45

# Must match EXACTLY the secret you type into the Razorpay dashboard when
# creating the webhook (Settings -> Webhooks -> Add New Webhook) -- you
# choose this string, Razorpay doesn't generate it. Falls back to a dev
# fixture if unset, so local curl/testing works without this; a real
# Razorpay webhook will 401 until it's set to the value you configured
# in their dashboard.
# RAZORPAY_WEBHOOK_SECRET=whsec_...

# Test-mode credentials from Settings -> API Keys in the Razorpay dashboard.
# Never commit real values here -- this file is the template, .env is not
# tracked by git. Test-mode keys move no real money, but treat them as
# real secrets anyway (don't paste them into chat, docs, or logs).
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...

# Day 11 explainability. Unset by default -- app/explain.py fails closed to
# a deterministic template narrative (never blocks the demo, never fakes an
# LLM call) rather than skipping explanation entirely.
# ANTHROPIC_API_KEY=sk-ant-...
# EXPLAIN_MODEL=claude-haiku-4-5
