DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/revenue_recovery

# UUID of the (only) business this deploy serves. Defaults in code to the
# id `python -m seed.reference --seed 42` always produces; override if you
# reseeded with a different --seed.
# DEMO_BUSINESS_ID=6765c159-0551-59dd-bb83-bf5277a98f45

# Must match EXACTLY the secret you type into the Razorpay dashboard when
# creating the webhook (Settings -> Webhooks -> Add New Webhook) -- you
# choose this string, Razorpay doesn't generate it. Falls back to a dev
# fixture if unset, so local curl/testing works without this; a real
# Razorpay webhook will 401 until it's set to the value you configured
# in their dashboard.
# RAZORPAY_WEBHOOK_SECRET=whsec_...

# Day 11 explainability. Unset by default -- app/explain.py fails closed to
# a deterministic template narrative (never blocks the demo, never fakes an
# LLM call) rather than skipping explanation entirely.
# ANTHROPIC_API_KEY=sk-ant-...
# EXPLAIN_MODEL=claude-haiku-4-5

# Which scorer prioritises the batch: baseline (statistical, no files
# needed) | xgboost (the trained score_ml@v1 weights in models/) | off
# (neutral 0.5 for everything). Defaults to baseline, so the TRAINED MODEL
# IS DORMANT UNLESS YOU SET THIS -- with models/b2c.json and models/b2b.json
# present, xgboost is almost certainly what you want; it falls back to
# baseline on its own if a model fails to load or predict.
# RISK_MODEL=xgboost

# Live voice/WhatsApp. Unset by default -- the dispatch worker routes to the
# simulated sender and never fabricates a delivery. TWILIO_ALLOWLIST is the
# ONLY set of numbers ever handed to Twilio's real API: everything else is
# simulated regardless of provider, which is what keeps a walk-up demo form
# from being able to call a stranger (and what keeps a trial account from
# rejecting the send outright).
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VOICE_NUMBER=+1...
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_ALLOWLIST=+91...
